# Copy to `.env` for local development (`npm run dev`).
# Production Docker/CI uses committed `.env.production` (see `.gitignore`); `npm run build:prod` runs `vite build`, which loads it automatically. Do not put secrets you refuse to ship in the client bundle.

VITE_BLOCKS_API_URL=https://api.seliseblocks.com
VITE_API_BASE_URL=https://api.seliseblocks.com
VITE_X_BLOCKS_KEY=replace-with-your-blocks-project-key
VITE_CAPTCHA_SITE_KEY=
VITE_CAPTCHA_TYPE=
VITE_PROJECT_SLUG=pemfes

# Optional. JWT (e.g. read-scoped service account from IAM) baked into the production bundle so
# anonymous visitors can load /site/... via Data Gateway when the API rejects key-only requests.
# Prefer configuring the gateway for anonymous read of published VibeWebsite/VibePage if your
# platform supports it; then leave this unset.
# VITE_VIBE_PUBLIC_READ_TOKEN=
